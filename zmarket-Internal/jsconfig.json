{
  "compilerOptions": {
    "baseUrl": ".",
    "checkJs": false,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "resources/js/marketplace/*"
      ]
    }
  },
  "include": [
    "resources/js/marketplace/**/*.js",
    "resources/js/marketplace/**/*.jsx",
    "vite.config.js"
  ],
  "exclude": [
    "node_modules",
    "public/build",
    "vendor"
  ]
}